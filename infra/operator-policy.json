{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2Describe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2RunBenchmarkInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        },
        "StringLike": {
          "ec2:InstanceType": [
            "c5.*", "c6i.*", "c7i.*", "m5.*", "m6i.*", "m7i.*"
          ]
        }
      }
    },
    {
      "Sid": "Ec2RunInstancesSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:*:subnet/*",
        "arn:aws:ec2:*:*:security-group/*",
        "arn:aws:ec2:*:*:network-interface/*",
        "arn:aws:ec2:*:*:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "REGION"
        }
      }
    },
    {
      "Sid": "Ec2CreateTagsOnRun",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "Ec2TerminateOwnRunners",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/baas-role": "benchmark-runner"
        }
      }
    },
    {
      "Sid": "SsmMongoConnectionString",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/RESOURCE_PREFIX/mongo/connection-string"
    },
    {
      "Sid": "SsmAmiLookup",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:REGION::parameter/aws/service/ami-amazon-linux-latest/*"
    },
    {
      "Sid": "S3WorkingBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::baas-RESOURCE_PREFIX",
        "arn:aws:s3:::baas-RESOURCE_PREFIX/*"
      ]
    },
    {
      "Sid": "PassRunnerRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/RESOURCE_PREFIX-runner-role"
    },
    {
      "Sid": "CloudFormationReadOwnStack",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": "arn:aws:cloudformation:REGION:ACCOUNT_ID:stack/baas-RESOURCE_PREFIX/*"
    }
  ]
}
