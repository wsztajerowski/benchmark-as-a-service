  CLI --> S3
  RUN --> DDB
  RUN --> S3
  SH -->|"job_status update-item"| DDB
  SH -->|"environment.json, logs"| S3

  G1["Owned by nobody, spelled separately on each side<br/>artifact leaf names (B3) · runner flags + type names (B4)<br/>job-item attribute names in bash (B2)"]:::gap
  G2["NOT_TERMINAL guard lives in the CLI adapter<br/>DynamoDbJobRecorder, not in baas-model (B2)"]:::gap
  G1 -.- SH
  G1 -.- RUN
  G2 -.- CLI
