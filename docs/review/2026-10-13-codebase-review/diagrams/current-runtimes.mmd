flowchart TB
  classDef mod fill:#e8f0fe,stroke:#3367d6,color:#111
  classDef sh fill:#fff4e5,stroke:#e8710a,color:#111
  classDef aws fill:#f1f3f4,stroke:#5f6368,color:#111
  classDef gap fill:#fde7e9,stroke:#d33,color:#111

  subgraph LAPTOP["Laptop / CI"]
    CLI["baas-cli<br/>89 classes, 12.4k lines<br/>commands (+ admin.setup) + infra + jobs + results"]:::mod
  end
  MODEL["baas-model<br/>JobId · JobLayout prefix · JobStatus · TagKeys<br/>ResultKeys · MeasurementItemMapper · JobItemMapper"]:::mod
  subgraph EC2["EC2 runner instance"]
    SH[["user-data bash<br/>rendered by UserDataScriptBuilder"]]:::sh
    RUN["benchmark-runner<br/>53 classes, 3.1k lines"]:::mod
  end
  subgraph AWS["AWS"]
    DDB[("DynamoDB results table")]:::aws
