@startuml
!define AWSPUML https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v14.0/LATEST/AWSPUML
skinparam componentStyle rectangle

package "Local Developer Environment" {
  [run-remote-benchmark.zsh] as Script
  [wait-for-gha-run.sh] as WaitScript
  [gh CLI / git / mvn] as CLI
}

package "Source & CI" {
  [GitHub Repo: lynx-journal] as RepoApp
  [GitHub Repo: benchmark-as-a-service] as RepoBaaS
  [GitHub Actions (workflow runner)] as GHActions
}

package "AWS" {
  [S3 Bucket: baas-lynx-main] as S3
  [Worker Provisioner / Orchestrator\n(what workflow executes)] as Orchestrator
  [Worker Instances\n(EC2 / ECS / Fargate / Spot)] as Worker
}

package "External Services" {
  [MongoDB (BaaS) - benchmark DB] as MongoDB
}

' connections
Script --> RepoApp : (local code)
Script --> CLI : uses gh, git, mvn, mongosh
Script --> S3 : upload jmh-benchmarks.jar
Script --> RepoBaaS : gh workflow run (passes inputs)\nrequest_id, results_path,\nbenchmark_type, benchmark_path, parameters
GHActions --> Orchestrator : runs workflow steps to provision\nand schedule benchmark job
Orchestrator --> Worker : provision/start worker(s)
Worker --> S3 : download jar / upload results
Worker --> MongoDB : write benchmark documents
GHActions --> Script : run status (Script polls using gh run list/wait script)
Script --> MongoDB : (optionally) query results via mongosh
Script --> Developer : prints results & S3 link

' annotations
note left of Script
 - sets REQUEST_ID
 - constructs TAGS and WORKFLOW_PARAMS
 - uses AWS_PROFILE (for S3 upload)
end note

note right of Worker
 - runs JMH benchmarks
 - writes output files (JSON/CSV) to S3
 - inserts metrics into MongoDB
end note

@enduml