sequenceDiagram
    actor User as Operator or CI job
    participant RC as ResultsQuerySubcommand
    participant RD as ResultsDiffSubcommand
    participant CFG as config file
    participant Git as git (working directory)
    participant DDB as DynamoDB<br/><prefix>-results
    participant Out as stdout (Console)

    User->>RC: baas results query [--project p | --all-projects | --job-id id]<br/>[--benchmark-name re] [--tag k=v]… [--best-per tag] [--show-hidden]<br/>[--limit n] [--format table|json|csv] [--watch]

    rect rgb(255, 235, 235)
        Note over RC: Usage checks, before config or AWS -- exit 2
        RC->>RC: --format not table/json/csv?
        RC->>RC: --watch with a non-table format, or without a terminal?
        RC->>RC: --job-id with --project / --benchmark-name / --tag / --all-projects?
        RC->>RC: --project with --all-projects?
    end

    RC->>CFG: OperatorSession.config() -- table = <prefix>-results, or exit 1 "No deployment"

    alt --job-id id
        RC->>DDB: Query jobId-index (gsi1pk = id) -- no hidden filter, filter attribute_exists(kind) drops the job item
    else --all-projects
        RC->>DDB: Scan, begins_with(pk, RESULT#35;) (hidden filtered unless --show-hidden)
    else project-scoped
        alt --project p
            Note over RC: p
        else git.resolveProject = true and cwd is in a repository
            RC->>Git: repository name of cwd
        else otherwise
            RC->>DDB: Scan for visible projects, begins_with(pk, RESULT#35;) -- job items never offer a project
            alt none
                RC-->>User: error, exit 1
            else no terminal, or format is json/csv
                RC-->>User: error listing projects, exit 1
            else interactive
                RC->>Out: numbered picker
                User-->>RC: a number (anything else: refuse, exit 1)
            end
        end
        RC->>DDB: Query pk = RESULT#35;<project>
    end

    Note over RC: Filter by name regex, --tag and --exclude-tag (warn on a tag no row carries).<br/>With --best-per: keep the best per (project, benchmark, params, mode, tag) -- highest for thrpt,<br/>lowest for avgt/sample/ss. Sort (newest first by default), skip --offset, cut to --limit (20, 0 = all).
    alt --watch
        loop every 30 s until Ctrl+C (alternate screen)
            RC->>DDB: same query
            RC->>Out: redraw frame
        end
        RC->>Out: reprint last frame on the normal screen
    else once
        RC->>Out: table (params and tags only with -v) | JSON array | CSV
    end

    rect rgb(240, 248, 255)
        Note over User,Out: baas results diff <jobA> <jobB> [--format table|json] [-v] -- two jobs' measurements, no S3
        User->>RD: baas results diff 20260724T120000000Z-a3f9c21b 20260811T093000000Z-b7e4d0f2
        alt not a job id, the same id twice, or an unknown --format
            RD-->>User: usage error, exit 2 -- no AWS call
        end
        RD->>DDB: Query jobId-index (gsi1pk = A), no kind filter -- the job item proves the job exists
        alt no job item
            RD-->>User: "No job found" naming A, exit 1 -- B not looked up
        end
        RD->>DDB: Query jobId-index (gsi1pk = B), same
        alt no job item
            RD-->>User: "No job found" naming B, exit 1
        end
        Note over RD: Library guard on the stored kind, never the type tag
        alt kinds differ (JMH and JCStress)
            RD-->>User: "different libraries are not comparable", exit 1
        else a side is JCStress
            RD-->>User: "not supported yet", names results query --job-id, exit 1
        end
        Note over RD: Pair by benchmark, mode, params. Delta B against A always. Verdict: units differ, ? (error unknown),<br/>~ (intervals overlap), else regression or improvement by the mode. Then only in A, only in B.
        opt imageVersion, jdk, jvmVendor, cpuModel or cpuArch differ
            RD-->>User: warning on stderr naming baas jobs diff A B
        end
        RD->>Out: header (job, instance type, benchmark type) then the rows (-v adds raw secondary metrics) or one JSON object
        Note over RD,Out: exit 0 whatever the verdicts
    end
