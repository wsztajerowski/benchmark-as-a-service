%% The workflow a user walks, end to end. Transitions in [brackets] happen outside the CLI.
%% State machines for each part: baas-states-deployment, baas-states-operator, baas-states-job.
flowchart TD
    A0([empty account]) -->|"[outside] attach the policy<br/>← baas admin deployment setup prints it when missing"| A1[deployer authorised]
    A1 -->|"baas admin deployment setup [--region] [federation flags]<br/>the only place a region is chosen"| A2[stack deployed, no image]
    A2 -->|"baas admin image build [--extension f] (~15 min)"| A3[deployment ready]
    A3 -->|"[outside] grant a teammate sts:AssumeRole (no role_arn profile)"| O0
    subgraph op [operator machine]
        O0([no config]) -->|"baas --deployment P config sync --operator-aws-profile p<br/>proves p assumes the operator role, finds the region"| O2[operator]
        O0 -->|"CI: no file, no sync -- the operator role names P"| O2
    end
    O2 -->|"baas run --benchmark-jar J --project X TYPE -- …"| R1{{one job}}
    R1 -->|"baas jobs list / jobs terminate ID"| R1
    R1 -->|completed| Q1["baas query [--project X | --job-id ID] · baas jobs show ID"]
    R1 -->|"failed / timed-out / vanished"| Q2["baas jobs download ID → cloud-init-output.log"]
    Q1 --> Q3["baas jobs download ID · baas jobs diff ID ID"]
    A3 -->|"baas admin deployment teardown — nothing survives<br/>saves the extension, retires the image"| A0
