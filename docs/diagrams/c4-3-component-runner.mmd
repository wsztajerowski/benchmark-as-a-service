C4Component
    title benchmark-runner — Components (level 3), as it runs on the EC2 instance

    Component_Ext(userData, "user-data script", "bash, generated by UserDataScriptBuilder", "IMDSv2 id, watchdog, environment.json, timeout java -jar, run-status, self-terminate")

    Container_Boundary(runner, "benchmark-runner.jar") {
        Component(wrapper, "TestWrapper", "picocli root", "Subcommands: jmh, jmh-with-async, jmh-with-prof, jcstress")
        Component(subcommands, "Subcommands + Api*Options", "picocli", "Parse the parameters baas run forwarded after --")
        Component(services, "*SubcommandService (+Builder)", "Java", "One per type; drives the benchmark process and the upload")
        Component(process, "BenchmarkProcessBuilder", "ProcessBuilder", "Spawns java -jar benchmark.jar with JMH / profiler / JCStress flags")
        Component(loader, "ResultLoaderService + JmhRunResults / JCStressHtmlResultParser", "Jackson, jsoup", "Reads jmh-result.json or the JCStress HTML report")
        Component(mappers, "JmhMeasurementMapper / JCStressMeasurementMapper", "Java", "Build StoredMeasurement values")
        Component(store, "ResultsStore", "DynamoDbResultsStore | MongoResultsStore | NoOpResultsStore", "Exactly one of --results-table, --mongo-connection-string, --no-database")
        Component(storage, "StorageService", "S3StorageService | LocalStorageService", "Uploads output, result JSON, profiler artifacts, logs/*.log")
    }

    Component_Ext(model, "baas-model", "shared JAR", "MeasurementItemMapper, ResultKeys, RunLayout, TagKeys")
    ComponentDb_Ext(table, "Results table", "DynamoDB")
    ComponentDb_Ext(bucket, "Run bucket", "S3")

    Rel(userData, wrapper, "timeout N java -jar benchmark-runner.jar <type> --results-table … --tag …")
    Rel(wrapper, subcommands, "dispatches")
    Rel(subcommands, services, "builds and calls")
    Rel(services, process, "spawns")
    Rel(services, loader, "reads results")
    Rel(loader, mappers, "maps")
    Rel(services, store, "save")
    Rel(services, storage, "upload")
    Rel(store, model, "items + keys")
    Rel(store, table, "PutItem")
    Rel(storage, bucket, "PutObject")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
