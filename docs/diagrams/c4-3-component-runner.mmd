C4Component
    title benchmark-runner — Components (level 3), as it runs on the EC2 instance

    Component_Ext(userData, "user-data script", "bash, generated by UserDataScriptBuilder", "job_status(), IMDSv2 id, watchdog (records timed-out), running, environment.json, timeout java -jar, completed/failed:N on the job item, self-terminate")

    Container_Boundary(runner, "benchmark-runner.jar — commands on top, options and the root package as leaves") {
        Component(wrapper, "commands: TestWrapper + four subcommands", "picocli", "JmhSubcommand, JmhWithAsyncProfilerSubcommand, JmhWithProfilerSubcommand, JCStressSubcommand; Api*Options mixins name their flags from RunnerArgs / BenchmarkType")
        Component(options, "options", "records, imports nothing internal", "CommonSharedOptions, JmhOptions (+ Benchmark/Iteration/Jvm/Output/Warmup), AsyncProfilerOptions, JCStressOptions, S3Options")
        Component(services, "services: *SubcommandService", "Java, constructed directly — no builders", "One per type: run the process, save its output, JobLogs.upload, map, resultsStore.write")
        Component(process, "process", "BenchmarkProcessBuilder, JmhBenchmarkProcessBuilderFactory", "Spawns java -jar benchmark.jar with JMH / profiler / JCStress flags")
        Component(results, "results", "JmhRunResults, JmhMeasurementMapper, JCStressMeasurementMapper", "uploadJsonAndMap: jmh-result.json to storage, then StoredMeasurement values")
        Component(infra, "infra", "ResultsStore (DynamoDbResultsStore | MongoResultsStore, via ResultsStoreBuilder), StorageService.of (S3StorageService | LocalStorageService), ResultLoaderService, JCStressHtmlResultParser, HtmlParser", "Adapters and parsers; exactly one of --results-table, --mongo-connection-string")
        Component(entities, "entities", "JmhResult, Metric, JCStressResult, MongoMeasurementDocument", "Parsed result shapes; Morphia maps this package")
    }


    Component_Ext(model, "baas-model", "shared JAR", "StoredMeasurement, MeasurementItemMapper, ResultKeys, JobLayout, TagKeys, RunnerArgs, BenchmarkType")
    ComponentDb_Ext(table, "Results table", "DynamoDB")
    ComponentDb_Ext(bucket, "Job bucket", "S3")

    Rel(userData, wrapper, "timeout N java -jar benchmark-runner.jar <type> --results-table … --tag …")
    Rel(wrapper, services, "new …SubcommandService(storage, store, options).executeCommand()")
    Rel(wrapper, infra, "buildResultsStore, StorageService.of")
    Rel(services, process, "spawns")
    Rel(services, results, "uploadJsonAndMap")
    Rel(results, infra, "ResultLoaderService")
    Rel(services, options, "reads")
    Rel(infra, model, "items + keys")
    Rel(infra, table, "BatchWriteItem")
    Rel(infra, bucket, "PutObject")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
