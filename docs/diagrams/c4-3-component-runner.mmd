C4Component
    title benchmark-runner — Components (level 3), as it runs on the EC2 instance

    Component_Ext(userData, "user-data script", "bash, generated by UserDataScriptBuilder", "job_status(), IMDSv2 id, watchdog (records timed-out), running, environment.json, timeout java -jar, completed/failed:N on the job item, self-terminate")

    Container_Boundary(runner, "benchmark-runner.jar — commands on top, options and the root package as leaves") {
        Component(wrapper, "commands: TestWrapper + two subcommands", "picocli", "JmhSubcommand, JCStressSubcommand: runner options, then the benchmark's own arguments after --; BenchmarkArguments refuses managed and no-run flags; option names from RunnerArgs / BenchmarkType")
        Component(options, "options", "records, imports nothing internal", "CommonSharedOptions, JmhRun, JCStressRun, S3Options")
        Component(services, "services: *SubcommandService", "Java, constructed directly — no builders", "One per type: run the process, save its output (and jmh-result.json), JobLogs.upload, map, resultsStore.write")
        Component(process, "process", "BenchmarkProcessBuilder", "Spawns the selected JDK's java (or java from PATH) -jar benchmark.jar with the user's arguments plus the managed result and profiler flags")
        Component(results, "results", "JmhRunResults, JmhMeasurementMapper, JCStressMeasurementMapper", "map: StoredMeasurement values, each naming the uploaded jmh-result.json")
        Component(infra, "infra", "ResultsStore (DynamoDbResultsStore, via ResultsStoreBuilder), StorageService.of (S3StorageService), ResultLoaderService, JCStressHtmlResultParser, HtmlParser", "Adapters and parsers; --results-table and --s3-bucket both required")
        Component(entities, "entities", "JmhResult, Metric, JCStressResult", "Parsed result shapes")
    }


    Component_Ext(model, "baas-model", "shared JAR", "StoredMeasurement, MeasurementItemMapper, ResultKeys, JobLayout, TagKeys, RunnerArgs, BenchmarkType")
    ComponentDb_Ext(table, "Results table", "DynamoDB")
    ComponentDb_Ext(bucket, "Job bucket", "S3")

    Rel(userData, wrapper, "timeout N java -jar benchmark-runner.jar <type> --results-table … --s3-bucket … [--jdk …] --tag …")
    Rel(wrapper, services, "new …SubcommandService(storage, store, options).executeCommand()")
    Rel(wrapper, infra, "buildResultsStore, StorageService.of")
    Rel(services, process, "spawns")
    Rel(services, results, "map")
    Rel(results, infra, "ResultLoaderService")
    Rel(services, options, "reads")
    Rel(infra, model, "items + keys")
    Rel(infra, table, "BatchWriteItem")
    Rel(infra, bucket, "PutObject")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
