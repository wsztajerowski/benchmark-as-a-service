C4Component
    title baas CLI — Components (level 3): composition root, kernel, five slices (ADR 0009)

    Container_Boundary(rootB, "pl.wsztajerowski.baas — composition root, imported by nothing") {
        Component(app, "BaasApp, AdminCommand", "picocli root, implements cli.Root", "Registers all five slices plus the run / query aliases; --deployment (inherited), -v pre-scan, failure reporting")
    }

    Container_Boundary(slices, "Slices — one per noun; imports only deployment → jobs → {image, results}") {
        Component(deployment, "deployment (+ deployment.setup)", "DeploymentCommand, SetupCommand, TeardownCommand, DeployerPolicyRenderer, DeployerPreflight", "Setup = SetupSteps over the SetupAws port (AwsSetupAws): eleven SetupStep classes run by SetupWalkthrough. Teardown builds its adapters inline")
        Component(jobs, "jobs", "JobsCommand, RunCommand, Jobs{List,Show,Diff,Download,Terminate}Subcommand", "run = JobLaunch over the RunAws port (AwsRunAws); JobSession, JobStop, JobTermination, JobListing, DynamoDbJobRecorder, Ec2ProvisioningService, RunnerJarResolver, UserDataScriptBuilder, EnvironmentManifest, PackagesDiff, JobPaths")
        Component(image, "image", "AdminImageCommand, ImageBuildSubcommand, ImageShowSubcommand", "RunnerImageBuild (the build use case), ImageBuilderService, RunnerImageRenderer, RunnerImageParameters, RunnerImageExtension, ParentImageResolver, RunnerImage")
        Component(results, "results", "ResultsCommand, ResultsQuerySubcommand", "ResultsQueryService, ResultsFilters, ResultsGrouping, ResultsTable, ResultRow")
        Component(config, "config", "ConfigCommand, Config{List,Set,Show,Sync}Subcommand", "Standalone: imports the kernel only")
    }

    Container_Boundary(kernel, "Kernel — every slice may use it, it imports no slice") {
        Component(cli, "cli", "Root, Invocation, LoggingMixin, BaasVersion", "How a command reads the root's --deployment and config root without importing BaasApp")
        Component(console, "console", "Console, StatusLine, Table, Json, Csv, Hints, Watch, Elapsed", "stdout payload; colour and redraw only when interactive")
        Component(session, "session", "ConfigService, BaasConfig, DeploymentNames, OperatorSession, DeployerSession, CoreStack, GitProject, DeploymentNameRule", "Which deployment, which credentials; DeploymentNames composes every resource name")
        Component(aws, "aws", "AwsClientFactory, CloudFormationService, S3UploadService, BucketProbe, AwsErrors, Checksums", "Shared AWS SDK v2 readers and writers")
    }

    Container_Boundary(model, "baas-model.jar — the one contract (CLI, runner, user-data)") {
        Component(contract, "model + model.dynamodb", "JobId, JobLayout, JobStatus, ResultKeys, TagKeys, RunnerArgs, BenchmarkType | JobItemMapper, MeasurementItemMapper, JobItemConditions", "Names, keys, statuses; model imports no AWS SDK")
    }

    Rel(app, jobs, "registers (and every other slice)")
    Rel(deployment, jobs, "Ec2ProvisioningService (teardown gate)")
    Rel(deployment, image, "RunnerImageBuild, ImageBuilderService.retireDeployment")
    Rel(jobs, image, "RunnerImage, ImageBuilderService.currentImage")
    Rel(jobs, results, "ResultsQueryService, ResultsTable, ResultRow")
    Rel(jobs, session, "OperatorSession, DeploymentNames")
    Rel(deployment, session, "DeployerSession, ConfigService")
    Rel(results, console, "Table, Json, Csv, Watch")
    Rel(config, session, "ConfigService, OperatorSession")
    Rel(cli, session, "Invocation → ConfigService")
    Rel(session, aws, "AwsClientFactory, BucketProbe")
    Rel(jobs, contract, "JobId, JobLayout, JobStatus, keys")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
