sequenceDiagram
    actor User as Operator or CI job
    participant DL as DownloadCommand
    participant ED as EnvDiffSubcommand
    participant DDB as DynamoDB<br/>jobId-index
    participant S3 as S3 bucket <prefix>
    participant FS as Local directory

    rect rgb(240, 248, 255)
        Note over User,FS: baas download <jobId|resultPath> [-o dir]
        User->>DL: baas download 20260820T174432812Z-a3f9c21b
        alt argument matches the job-id shape
            DL->>DDB: resultPathForJob(id)
            Note over DL,DDB: the job item first (gsi1sk = JOB), so a failed or never-launched job<br/>resolves too. A job from before job items resolves through a measurement.
            alt no item (only: a job from before job items that stored nothing)
                DL-->>User: "No job found", exit 1 -- nothing written
            end
            DDB-->>DL: stored resultPath (read, never reconstructed)
        else anything else is taken as a literal result path
            Note over DL: jobs/<project>/<jobId> or a pre-unified-layout path
        end
        DL->>S3: ListObjectsV2(prefix/)
        alt empty
            DL-->>User: "No artifacts found", exit 1 -- nothing written
        end
        loop each key, input/ JARs included
            alt key resolves outside the output directory (../ or a leading /)
                Note over DL: skipped and logged, never written
            else
                DL->>S3: GetObject
                DL->>FS: write under -o, default ./<last path segment>
            end
        end
        opt any key skipped
            DL-->>User: exit 1 -- the job's prefix holds keys BaaS never wrote
        end
    end

    rect rgb(245, 255, 245)
        Note over User,FS: baas env diff <jobA> <jobB> -- each a job id or a result path,<br/>resolved by the same JobReference as download
        User->>ED: baas env diff <jobIdA> <jobIdB>
        loop each argument shaped like a job id
            ED->>DDB: resultPathForJob(id)
            alt no item (also: a job that failed before storing a measurement)
                ED-->>User: "No job found with id ..." naming the path form, exit 1 -- S3 not read
            end
        end
        ED->>S3: GetObject <A>/environment.json
        ED->>S3: GetObject <B>/environment.json
        alt either missing
            ED-->>User: error naming the key, exit 1
        end
        opt schemaVersion differs
            ED-->>User: warn (stderr)
        end
        ED-->>User: "No differences." or FIELD / A / B table on stdout
    end
