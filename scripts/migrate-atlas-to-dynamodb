#!/usr/bin/env bash
# Migrates historical MongoDB Atlas measurements into the DynamoDB results table.
#
# Throwaway, by design (openspec/changes/dynamodb-results-store/design.md): it exists so
# mongodb-driver-sync never has to reach baas-cli, and task 10.3 deletes it once §9.8's
# verification passes. Nothing in CI runs it — its only protection is --dry-run and the row-count
# check afterwards.
#
# The real work is scripts/MigrateAtlasToDynamoDb.java, run as a single-file source program
# against the shaded runner JAR: that JAR already carries the Mongo driver, the DynamoDB SDK and
# baas-model, so the migration writes keys through the same ResultKeys/MeasurementItemMapper the
# runner uses rather than a second hand-rolled copy.
#
#   scripts/migrate-atlas-to-dynamodb --dry-run
#   scripts/migrate-atlas-to-dynamodb
#
# Options:
#   --dry-run             report counts per collection and per project partition; write nothing
#   --limit <n>           stop after n documents per collection (smoke test)
#   --table <name>        results table (default: the core stack's baas-<prefix>-results)
#   --prefix <prefix>     resource prefix (default: from ~/.baas/config.yaml)
#   --profile <name>      AWS profile used to WRITE the table (default: AWS_PROFILE, else the chain)
#   --ssm-profile <name>  AWS profile used to READ the connection string (default: --profile)
#   --region <region>     AWS region (default: AWS_REGION, else eu-central-1)
#
# The connection string is read from SSM at /<prefix>/mongo/connection-string and passed to the
# JVM in the environment, never in argv — argv is visible to every process on the machine.
#
# This usually needs TWO principals, because BaaS splits reading from provisioning on purpose:
#   - reading  /<prefix>/mongo/connection-string  is an OPERATOR grant (ssm:GetParameter)
#   - writing  the results table                  needs dynamodb:BatchWriteItem, which neither
#     the operator role nor the deployer policy grants
# So point --ssm-profile at the operator and --profile at whoever holds the write:
#
#   scripts/migrate-atlas-to-dynamodb --dry-run --profile admin --ssm-profile baas-operator
#
# Setting MONGO_CONNECTION_STRING in the environment skips the SSM read entirely.
set -euo pipefail

repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
runner_jar="$repo_root/benchmark-runner/target/benchmark-runner.jar"
# The CLI JAR joins the classpath purely for the STS module. A role-assuming profile
# (role_arn + source_profile) cannot resolve without it, and --ssm-profile/--profile pointing at
# the operator role is the documented way to run --verify. The runner never assumes a role, so
# its shaded JAR does not carry STS; the CLI does, for sts:GetCallerIdentity. Runner first, so
# it wins every duplicate and the migration still runs against the classes the runner writes with.
cli_jar="$repo_root/baas-cli/target/baas-cli.jar"
program="$repo_root/scripts/MigrateAtlasToDynamoDb.java"

prefix=""
profile="${AWS_PROFILE:-}"
ssm_profile=""
region="${AWS_REGION:-eu-central-1}"
table="${BAAS_RESULTS_TABLE:-}"
forwarded=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --prefix)  prefix="$2"; shift 2 ;;
    --profile) profile="$2"; shift 2 ;;
    --ssm-profile) ssm_profile="$2"; shift 2 ;;
    --region)  region="$2"; shift 2 ;;
    --table)   table="$2"; shift 2 ;;
    *)         forwarded+=("$1"); shift ;;
  esac
done

if [[ ! -f "$runner_jar" ]]; then
  echo "Runner JAR not found: $runner_jar" >&2
  echo "Build it first:  mvn -pl benchmark-runner -am package -DskipTests" >&2
  exit 1
fi

if [[ -z "$prefix" ]]; then
  # Strip surrounding quotes: the CLI writes the prefix as a quoted YAML scalar, and a quoted
  # prefix silently builds a parameter name that matches nothing — surfacing as an IAM denial on
  # a resource ARN that looks nothing like what was asked for.
  prefix="$(awk '/^prefix:/ {gsub(/^["'"'"']|["'"'"']$/, "", $2); print $2; exit}' \
    "${BAAS_CONFIG:-$HOME/.baas/config.yaml}" 2>/dev/null || true)"
fi
if [[ -z "$prefix" ]]; then
  echo "Cannot determine the resource prefix. Pass --prefix <prefix>." >&2
  exit 1
fi

if [[ -z "$table" ]]; then
  table="baas-${prefix}-results"
fi

export AWS_REGION="$region"
if [[ -n "$profile" ]]; then
  # Exported, not passed as a flag: this one is for the JVM's DynamoDB client, which reads the
  # environment. The SSM read below uses its own profile and must not inherit this one.
  export AWS_PROFILE="$profile"
fi

if [[ -z "${MONGO_CONNECTION_STRING:-}" ]]; then
  ssm_args=(--region "$region")
  if [[ -n "${ssm_profile:-$profile}" ]]; then
    ssm_args+=(--profile "${ssm_profile:-$profile}")
  fi
  MONGO_CONNECTION_STRING="$(aws "${ssm_args[@]}" ssm get-parameter \
    --name "/${prefix}/mongo/connection-string" \
    --with-decryption --query Parameter.Value --output text)"
  export MONGO_CONNECTION_STRING
fi

export BAAS_RESULTS_TABLE="$table"

classpath="$runner_jar"
if [[ -f "$cli_jar" ]]; then
  classpath="$runner_jar:$cli_jar"
fi

exec java -cp "$classpath" "$program" ${forwarded[@]+"${forwarded[@]}"}
